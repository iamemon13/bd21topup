NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SIAMBHAU_API_KEY=
GOXTOP_API_KEY=

# TEST-only EkPay server integration. Never expose these with NEXT_PUBLIC_.
EKPAY_ENABLED=false
EKPAY_API_BASE_URL=
EKPAY_API_KEY=

# Public Telegram destination; server-generated links default to existing BD21Support.
SUPPORT_TELEGRAM_USERNAME=BD21Support
# chat: prefilled draft; bot: /start payload (requires a configured external bot handler).
SUPPORT_TELEGRAM_MODE=chat

# Personal-account MTProto worker (disabled unless explicitly selected).
TELEGRAM_TRANSPORT_MODE=dry-run
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_FILE=.telegram/bd21topup.session
TELEGRAM_SUPPLIER_USERNAME=
TELEGRAM_SUPPLIER_ENTITY_ID=
TELEGRAM_REAL_SEND_ENABLED=false
TELEGRAM_PILOT_ACKNOWLEDGED=false

# Auto-create/reuse top-up dispatches after successful wallet orders.
AUTO_TOPUP_DISPATCH_ENABLED=false
AUTO_TOPUP_DISPATCH_ADMIN_ID=
